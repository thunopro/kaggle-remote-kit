#!/usr/bin/env python3
"""kdown <file|dir> [thư mục đích=.] : tải file/thư mục từ /kaggle/working về máy."""
import sys, os, json, base64, urllib.request, urllib.parse
u = open(os.path.expanduser("~/kaggle-work/.kjupyter/last_url")).read().strip()
base, tok = u.split("/?token=")
def api(p, q=""):
    r = urllib.request.Request(f"{base}/api/contents/{urllib.parse.quote(p)}?{q}", headers={"Authorization": f"token {tok}"})
    return json.load(urllib.request.urlopen(r, timeout=600))
def get(p, dest):
    m = api(p, "content=0")
    if m["type"] == "directory":
        for c in api(p)["content"]: get(c["path"], os.path.join(dest, os.path.basename(p)))
        return
    os.makedirs(dest, exist_ok=True); out = os.path.join(dest, os.path.basename(p))
    d = api(p, "content=1&format=base64")["content"]
    open(out, "wb").write(base64.b64decode(d)); print("✓", out)
dest = sys.argv[2] if len(sys.argv) > 2 else "."
get(sys.argv[1].lstrip("/").removeprefix("kaggle/working/"), dest)
