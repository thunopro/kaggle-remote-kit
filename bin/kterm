#!/usr/bin/env python3
"""kterm : terminal tương tác ngay trên máy Kaggle (cd, ls, unzip, nvidia-smi, pip...). Thoát: exit hoặc Ctrl-D."""
import sys, os, json, tty, termios, threading, signal, shutil, urllib.request, websocket
u = open(os.path.expanduser("~/kaggle-work/.kjupyter/last_url")).read().strip()
base, tok = u.split("/?token=")
r = urllib.request.Request(base + "/api/terminals", data=b"{}", method="POST", headers={"Authorization": f"token {tok}"})
name = json.load(urllib.request.urlopen(r, timeout=30))["name"]
ws = websocket.create_connection(base.replace("https", "wss") + f"/terminals/websocket/{name}?token={tok}", timeout=None)
def size():
    c, l = shutil.get_terminal_size(); ws.send(json.dumps(["set_size", l, c, 0, 0]))
size(); signal.signal(signal.SIGWINCH, lambda *a: size())
ws.send(json.dumps(["stdin", "cd /kaggle/working && clear && echo '☁  Kaggle terminal — /kaggle/working (thoát: exit)'\r"]))
fd = sys.stdin.fileno(); old = termios.tcgetattr(fd); done = threading.Event()
def reader():
    try:
        while True:
            m = json.loads(ws.recv())
            if m[0] == "stdout": os.write(1, m[1].encode())
            elif m[0] == "disconnect": break
    except Exception: pass
    done.set()
threading.Thread(target=reader, daemon=True).start()
try:
    tty.setraw(fd)
    import select
    while not done.is_set():
        if select.select([fd], [], [], 0.2)[0]:
            d = os.read(fd, 4096)
            if not d: break
            ws.send(json.dumps(["stdin", d.decode(errors="ignore")]))
finally:
    termios.tcsetattr(fd, termios.TCSADRAIN, old)
    try: ws.close()
    except Exception: pass
    try: urllib.request.urlopen(urllib.request.Request(f"{base}/api/terminals/{name}", method="DELETE", headers={"Authorization": f"token {tok}"}), timeout=10)
    except Exception: pass
    print("\n[đã thoát Kaggle terminal]")
