#!/usr/bin/env python3
"""kup <file|dir>...  : upload file local lên /kaggle/working của phiên Kaggle đang bật (kaggle on)."""
import sys, os, json, base64, urllib.request
u = open(os.path.expanduser("~/kaggle-work/.kjupyter/last_url")).read().strip()
base, tok = u.split("/?token=")
def put(local, remote, i, last, data):
    body = {"type":"file","format":"base64","name":os.path.basename(remote),"chunk":-1 if last else i,
            "content":base64.b64encode(data).decode()}
    r = urllib.request.Request(f"{base}/api/contents/{remote}", data=json.dumps(body).encode(), method="PUT",
        headers={"Authorization":f"token {tok}","Content-Type":"application/json"})
    urllib.request.urlopen(r, timeout=300).read()
def up(path):
    remote = os.path.basename(path); size = os.path.getsize(path); n = 0; CH = 8<<20
    with open(path,"rb") as f:
        while True:
            d = f.read(CH); n += len(d)
            last = n >= size
            put(path, remote, (n+CH-1)//CH, last, d)
            print(f"\r{remote}: {n*100//max(size,1)}%", end="", flush=True)
            if last: break
    print(f"  ✓ /kaggle/working/{remote}")
for p in sys.argv[1:]:
    if os.path.isdir(p):
        for fn in sorted(os.listdir(p)):
            fp = os.path.join(p, fn)
            if os.path.isfile(fp): up(fp)
    else: up(p)
