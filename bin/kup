#!/usr/bin/env python3
"""kup <file|dir>... : upload lên /kaggle/working. Thư mục được nén 1 file zip, upload 1 lần rồi giải nén bên Kaggle (giữ nguyên cấu trúc)."""
import sys, os, json, base64, urllib.request, zipfile, tempfile
u = open(os.path.expanduser("~/kaggle-work/.kjupyter/last_url")).read().strip()
base, tok = u.split("/?token=")
H = {"Authorization": f"token {tok}", "Content-Type": "application/json"}
def req(path, method="GET", body=None):
    r = urllib.request.Request(base + path, data=None if body is None else json.dumps(body).encode(), method=method, headers=H)
    return urllib.request.urlopen(r, timeout=600).read()
def upload(path, remote):
    size = os.path.getsize(path); n = 0; CH = 24 << 20; i = 0
    with open(path, "rb") as f:
        while True:
            d = f.read(CH); n += len(d); i += 1; last = n >= size
            req(f"/api/contents/{remote}", "PUT", {"type": "file", "format": "base64", "name": os.path.basename(remote),
                "chunk": -1 if last else i, "content": base64.b64encode(d).decode()})
            print(f"\r  {os.path.basename(path)}: {n*100//max(size,1)}%", end="", flush=True)
            if last: break
    print()
def remote_exec(code):
    import websocket
    kid = json.loads(req("/api/kernels", "POST", {}))["id"]
    ws = websocket.create_connection(base.replace("https", "wss") + f"/api/kernels/{kid}/channels?token={tok}", timeout=600)
    ws.send(json.dumps({"header": {"msg_id": "1", "username": "", "session": "kup", "msg_type": "execute_request", "version": "5.3"},
        "parent_header": {}, "metadata": {}, "channel": "shell", "buffers": [],
        "content": {"code": code, "silent": False, "store_history": False, "user_expressions": {}, "allow_stdin": False, "stop_on_error": True}}))
    err = None
    while True:
        m = json.loads(ws.recv())
        if m["parent_header"].get("msg_id") != "1": continue
        t = m["msg_type"]
        if t == "error": err = "\n".join(m["content"]["traceback"])
        if t == "status" and m["content"]["execution_state"] == "idle": break
    ws.close(); req(f"/api/kernels/{kid}", "DELETE")
    if err: sys.exit("Lỗi bên Kaggle:\n" + err)
for p in sys.argv[1:]:
    p = p.rstrip("/")
    if os.path.isdir(p):
        name = os.path.basename(os.path.abspath(p))
        z = os.path.join(tempfile.mkdtemp(), name + ".zip"); cnt = 0
        with zipfile.ZipFile(z, "w", zipfile.ZIP_STORED) as zf:
            for root, _, fs in os.walk(p):
                for fn in fs:
                    fp = os.path.join(root, fn); zf.write(fp, os.path.join(name, os.path.relpath(fp, p))); cnt += 1
        print(f"{name}/: {cnt} file → zip {os.path.getsize(z)/1e6:.1f} MB")
        upload(z, name + ".zip")
        remote_exec(f"import zipfile,os\nzipfile.ZipFile('/kaggle/working/{name}.zip').extractall('/kaggle/working')\nos.remove('/kaggle/working/{name}.zip')")
        os.remove(z); print(f"  ✓ /kaggle/working/{name}/")
    else:
        upload(p, os.path.basename(p)); print(f"  ✓ /kaggle/working/{os.path.basename(p)}")
