#!/usr/bin/env bash
# kwatch <topic>: gửi heartbeat mỗi 60s khi VS Code còn mở; VS Code tắt -> gửi stop
T="$1"; C="https://ntfy.sh/$T-ctl"; seen=0; miss=0; start=$(date +%s)
while :; do
  if pgrep -x code >/dev/null; then seen=1; miss=0
  else miss=$((miss+1)); fi
  if [ $seen = 1 ] && [ $miss -ge 2 ]; then break; fi
  if [ $seen = 0 ] && [ $(( $(date +%s)-start )) -gt 600 ]; then break; fi
  curl -s -m 10 -d hb "$C" >/dev/null; sleep 60
done
curl -s -m 10 -d stop "$C" >/dev/null; rm -f ~/kaggle-work/.kjupyter/watcher.pid
