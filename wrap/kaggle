#!/usr/bin/env bash
# Wrapper: kaggle on|off|status|url|time|up|ls|down|run|man = lệnh tự làm; còn lại -> Kaggle CLI thật
export PATH=$PATH:~/.local/bin
case "$1" in
  on) shift; exec kjupyter "$@";;
  off|status) exec kjupyter "$1";;
  url) u=$(cat ~/kaggle-work/.kjupyter/last_url 2>/dev/null); echo "${u:-OFF}"; printf %s "$u" | xclip -selection clipboard 2>/dev/null;;
  time) exec ktime;; up) shift; exec kup "$@";; ls) shift; exec kls "$@";; down) shift; exec kdown "$@";;
  terminal|term|sh) exec kterm;; rm) shift; exec kup --rm "$@";; run) shift; exec krun "$@";; man) exec kman;;
  *) exec ~/.local/bin/kaggle "$@";;
esac
